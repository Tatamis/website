---
import { siteConfig } from "../config";
---

<footer class="site-footer">
  <div class="footer shell">
    <a class="brand footer-brand" href="/" aria-label="CMPC projects home">
      <span class="brand-mark" aria-hidden="true">C_</span>
      <span>CMPC / PROJECTS</span>
    </a>

    <nav aria-label="Footer navigation">
      <a href="/projects">Projects</a>
      <a href="/lab">Lab</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
    </nav>

    <div class="footer-meta">
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      {siteConfig.githubProfile && <a href={siteConfig.githubProfile}>GitHub ↗</a>}
      <span>© {new Date().getFullYear()} CMPC</span>
    </div>
  </div>
</footer>
