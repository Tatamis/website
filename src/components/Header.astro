---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: "/projects", label: "Projects" },
  { href: "/lab", label: "Lab" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
---

<header class="site-header">
  <nav class="nav shell" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="CMPC projects home">
      <span class="brand-mark" aria-hidden="true">C_</span>
      <span>CMPC / PROJECTS</span>
    </a>

    <div class="nav-links" aria-label="Desktop navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[link.label === "Contact" && "nav-cta"]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
            {link.label === "Contact" && <span aria-hidden="true">↗</span>}
          </a>
        ))
      }
    </div>

    <details class="nav-menu">
      <summary>Menu</summary>
      <div class="nav-menu-panel">
        {
          links.map((link) => (
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
    </details>
  </nav>
</header>
