---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — CMPC" noindex>
  <section class="not-found shell">
    <p class="section-index">ERROR / 404</p>
    <h1>Project file not found.</h1>
    <p>The requested route is not part of this project archive.</p>
    <a class="button button-primary" href="/projects">Return to projects <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
