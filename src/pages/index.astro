---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const featuredProjects = projects.slice(0, 3);
const demoBars = [34, 48, 42, 70, 55, 83, 62, 94, 76, 88, 59, 72];
---

<BaseLayout>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        Independent security projects / 2026
      </p>
      <h1 id="hero-title">Security projects.<span> Built to be tested.</span></h1>
      <p class="hero-lede">
        Defensive tools, research systems, and operational experiments—documented
        from the problem to a working output.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#selected-work">
          Explore projects <span aria-hidden="true">↓</span>
        </a>
        <a class="button button-secondary" href="/contact">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <aside class="project-index-card" aria-label="Project index">
      <div class="panel-head">
        <span>PROJECT INDEX</span>
        <span>{String(projects.length).padStart(2, "0")} FILES</span>
      </div>
      <ol>
        {
          projects.map((project) => (
            <li>
              <a href={`/projects/${project.slug}`}>
                <span>{project.index}</span>
                <strong>{project.title}</strong>
                <small>{project.status}</small>
              </a>
            </li>
          ))
        }
      </ol>
    </aside>
  </section>

  <section class="statement shell" aria-label="Portfolio statement">
    <p class="section-index">[PROJECT-FIRST PORTFOLIO]</p>
    <p>The work is the profile.</p>
  </section>

  <section class="section shell" id="selected-work" aria-labelledby="selected-work-title">
    <div class="section-heading section-heading-row">
      <div>
        <p class="section-index">[01] / SELECTED WORK</p>
        <h2 id="selected-work-title">Projects with a clear purpose.</h2>
      </div>
      <a class="text-link" href="/projects">View all projects <span aria-hidden="true">↗</span></a>
    </div>

    <div class="featured-grid">
      {
        featuredProjects.map((project, index) => (
          <ProjectCard project={project} featured={index === 0} />
        ))
      }
    </div>
  </section>

  <section class="project-method shell" aria-labelledby="method-title">
    <div>
      <p class="section-index">[02] / PROJECT FILES</p>
      <h2 id="method-title">No empty showcase cards.</h2>
    </div>
    <ol>
      <li><span>01</span><strong>Problem</strong><p>What the project is trying to resolve and why it exists.</p></li>
      <li><span>02</span><strong>System</strong><p>How its parts connect and what each component is responsible for.</p></li>
      <li><span>03</span><strong>Output</strong><p>What can be inspected, tested, or reused when the project runs.</p></li>
    </ol>
  </section>

  <section class="lab-preview shell" aria-labelledby="lab-preview-title">
    <div class="lab-preview-copy">
      <p class="section-index">[03] / PROJECT LAB</p>
      <h2 id="lab-preview-title">See the systems in motion.</h2>
      <p>
        A demonstration surface for project telemetry, validation runs, and
        research outputs. Every value is illustrative and clearly marked.
      </p>
      <a class="button button-secondary" href="/lab">Enter the lab <span aria-hidden="true">↗</span></a>
    </div>

    <div class="signal-card" aria-label="Illustrative project signals">
      <div class="panel-head">
        <span>DEMO RUN / 08-2026</span>
        <span class="live-pill">ILLUSTRATIVE</span>
      </div>
      <div class="signal-metrics">
        <div><span>CAPTURED EVENTS</span><strong>1,284</strong></div>
        <div><span>TEST CASES</span><strong>42</strong></div>
        <div><span>VALIDATED</span><strong>91%</strong></div>
      </div>
      <div class="signal-bars" aria-hidden="true">
        {demoBars.map((height) => <span style={`--bar-height:${height}%`}></span>)}
      </div>
    </div>
  </section>

  <section class="contact-cta shell" aria-labelledby="contact-cta-title">
    <div>
      <p class="section-index">[04] / CONTACT</p>
      <h2 id="contact-cta-title">Have a project worth testing?</h2>
    </div>
    <a class="button button-primary" href="/contact">Send a message <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
